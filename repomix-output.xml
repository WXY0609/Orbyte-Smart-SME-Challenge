      } else if (query.includes('waste') || query.includes('save')) {
        botReply = "Following AI recommendations helps prevent overstock and saves up to ~$5,200 monthly!";
      }

      setMessages((prev) => [...prev, { sender: 'bot', text: botReply }]);
    }, 500);
